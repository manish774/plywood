# Loaded automatically by Vite for production builds (npm run build).
# Local dev keeps using .env (localhost) — this only affects deployed builds.

VITE_API_BASE_URL=https://plywood-backend-1ia4.onrender.com/api
VITE_USE_MOCK=false

# Used for canonical links, Open Graph/Twitter URLs, and JSON-LD in meta
# tags. Search engines and link-preview bots read this directly (they don't
# run in a browser, so the window.location.origin fallback doesn't help them).
VITE_SITE_URL=https://www.plyswastik.com
