# Base URL for the backend REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# When true, the app reads categories/items/contact from the local mock data
# instead of hitting the real API. Flip to false once the backend is wired up.
VITE_USE_MOCK=true

# Public origin the site is deployed at (no trailing slash) — used for
# canonical links, Open Graph/Twitter URLs, and JSON-LD. Falls back to
# window.location.origin if unset, but set this in production so crawlers
# and social scrapers (which don't run in a browser) get the real domain.
VITE_SITE_URL=http://localhost:5173
