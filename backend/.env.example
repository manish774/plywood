# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# Port the Express server listens on
PORT=5000

# Secret used to sign/verify admin JWTs (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_string

# Used only by `npm run seed:admin` to create/update the staff login record
# in the DB (Admin collection) — POST /api/admin/login checks the DB, not these.
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# SMTP credentials used to send OTP emails for user register/login
# (e.g. for Gmail: host smtp.gmail.com, port 587, and an App Password as EMAIL_PASS)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_smtp_username
EMAIL_PASS=replace_with_smtp_password
EMAIL_FROM=Plywood Shop <no-reply@example.com>

# Minutes an OTP stays valid before it must be resent
OTP_EXPIRY_MINUTES=10
