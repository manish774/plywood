# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# Port the Express server listens on
PORT=5000

# Secret used to sign/verify admin JWTs (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_string

# Single admin account (shop owner) credentials for POST /api/admin/login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
